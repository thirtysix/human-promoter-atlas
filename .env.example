# Human Promoter Atlas — local configuration.
#
# Copy to .env (gitignored) and fill in the paths for your machine.
# Real environment variables always override this file, so a one-off run can
# use `HPA_TIER=q1e-5 python pipeline/tss_modules.001.py` without editing it.
#
# Print the resolved configuration at any time with:
#     python pipeline/config.py


# ---------------------------------------------------------------------------
# Build axes — these two define WHICH atlas you are building
# ---------------------------------------------------------------------------
# ChIP-Atlas significance tier. NOTE the 10x numbering trap: bulk filenames use
# 05/10/20/50 (= Q < 1E-0N) while the ChIP-Atlas *website* picker uses
# 50/100/500/1000 (= -10*log10(Q)). We name tiers after the q-value, and
# pipeline/config.py holds the only mapping between the two conventions.
#   q1e-50 = Q<1E-50 (strictest, the original build)   q1e-20   q1e-10
#   q1e-5  = Q<1E-05 (loosest)
HPA_TIER=q1e-50

# Transcription-factor axis.
#   whitelist = the curated DNA_binding_genes.tsv intersection (1,304 TFs)
#   all       = every downloaded antigen that is a real GRCh38 gene symbol
#               (1,767 TFs; adds cohesin, Mediator, bromodomains, PRC1, SAGA)
# Generate the list for "all" with: python acquire/build_tf_list.py --tf-set all
HPA_TF_SET=whitelist


# ---------------------------------------------------------------------------
# Inputs
# ---------------------------------------------------------------------------
# ChIP-Atlas root. Peaks are expected at $HPA_CHIP_ATLAS_DIR/per_TF/$HPA_TIER/
HPA_CHIP_ATLAS_DIR=/path/to/chip-atlas/00.data/TF

# Optional explicit override. Must end in the configured tier — config.py
# refuses to run otherwise, because that mismatch is how builds get mislabelled.
#HPA_PER_TF_DIR=

HPA_GTF=/path/to/Homo_sapiens.GRCh38.114.gtf.gz
HPA_DNA_BINDING=/path/to/DNA_binding_genes.tsv
HPA_MSIGDB=/path/to/c5.go.bp.v2026.1.Hs.json
HPA_GTEX_DIR=/path/to/GTEx
HPA_DEPMAP_DIR=/path/to/DepMap

# Generated TF list. Defaults to acquire/tf_list.$HPA_TF_SET.txt
#HPA_TF_LIST=


# ---------------------------------------------------------------------------
# Outputs
# ---------------------------------------------------------------------------
# Pipeline output root. Each build lands in $HPA_ANALYSIS_ROOT/<tier>.<tf_set>/
# so tiers and axes coexist instead of overwriting each other.
HPA_ANALYSIS_ROOT=/path/to/analyses/canonical_promoter

# Explicit override — use this to reproduce the original flat layout, or to
# write a throwaway run somewhere else for a regression diff.
#HPA_OUT_DIR=


# ---------------------------------------------------------------------------
# Compute
# ---------------------------------------------------------------------------
# Worker processes. Unset is the right default: SLURM_CPUS_PER_TASK is used on
# HPC (os.cpu_count() there reports the whole 384-core node, not your cgroup),
# and locally it caps at 12.
#HPA_WORKERS=


# ---------------------------------------------------------------------------
# App / packaging (consumed by data/build_app_db.py and app/lib/db.py)
# ---------------------------------------------------------------------------
#HPA_ANALYSIS_DIR=
#HPA_DEPMAP_RAW=
#HPA_DATA_DIR=


# ---------------------------------------------------------------------------
# HPC (optional — only for running the heavy half on CSC Roihu)
# ---------------------------------------------------------------------------
# SLURM scripts export this as SBATCH_ACCOUNT rather than hardcoding
# `#SBATCH --account=`, which cannot expand shell variables.
#HPA_CSC_PROJECT=project_0000000
#HPA_SCRATCH=/scratch/project_0000000/human-promoter-atlas

# Durable storage for the zstd peak archive (external disk, NAS, wherever).
# Required by hpc/04_fetch_archive.sh -- no default, since it is machine-specific.
#HPA_ARCHIVE_DIR=/path/to/durable/chip-atlas
